# Copy to .env and fill in real values before running `docker compose up`.
# See BACKEND_NOTES.md for full documentation of each variable.

POSTGRES_DB=checkin
POSTGRES_USER=checkin
POSTGRES_PASSWORD=change-me-db-password

# HS256 signing secret for the session JWT (BLUEPRINT.md Section 6.1). Use a
# long random value in production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# Shared secret worker uses to call api's /internal/* endpoints, and api uses
# to call worker's /sync/{device_id} endpoint (BLUEPRINT.md Section 7).
INTERNAL_API_KEY=change-me-internal-key

# How often `worker` polls each active device, in seconds (BLUEPRINT.md
# Section 2.2 default: 300 = 5 minutes).
SYNC_INTERVAL_SECONDS=300

# Nightly daily-status processing trigger time, local to the host machine
# (BLUEPRINT.md Section 2.2 default: 02:00).
NIGHTLY_HOUR=2
NIGHTLY_MINUTE=0

# IANA timezone the K40 device's clock is assumed to be set to (see
# worker/worker/config.py — ASSUMPTION documented there and in
# BACKEND_NOTES.md). Should normally match the pilot location's
# `locations.timezone` value (default Europe/Tirane per BLUEPRINT.md 3.1 —
# no IANA zone exists for Prishtina; Kosovo and Albania share the same
# CET/CEST rules).
DEVICE_TIMEZONE=Europe/Tirane

# Comma-separated allowed origins for browser CORS (only exercised by
# `npm run dev` against a local `api`; the production nginx path is
# same-origin and does not need this). Wildcard "*" is not honored when
# credentialed cookies are in use — see SECURITY_REPORT.md.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to `true` once this deployment is served over HTTPS (required before
# any Phase 2 internet-facing exposure — see BLUEPRINT.md Section 6.1 and
# SECURITY_REPORT.md). Must stay `false` for the documented Phase 1 LAN-only,
# no-TLS deployment, since browsers silently drop `Secure` cookies over plain
# HTTP and login would appear to succeed but the session cookie would never
# be stored.
COOKIE_SECURE=false
