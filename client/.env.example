# chronos — client machine configuration.
# Copy this file to `.env` (same folder) and fill in the values, then:
#   docker compose pull && docker compose up -d
#
# Keep a copy of the finished .env somewhere safe and OFF this machine. The
# three secrets below cannot be recovered from a backup; losing them means
# every session is logged out and the worker stops being able to file punches.

# ---- Registry (where the app images are pulled from) ----------------------
# Your Docker Hub username, or ghcr.io/<your-github-user>.
REGISTRY=
# Which released version this machine runs. Leave at beta during testing.
TAG=beta

# ---- Secrets (generate fresh ones per client, never reuse) ----------------
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
INTERNAL_API_KEY=
POSTGRES_PASSWORD=

# ---- Database -------------------------------------------------------------
POSTGRES_DB=chronos
POSTGRES_USER=chronos

# ---- Web ------------------------------------------------------------------
# Port on this machine where staff open the app: http://<this-pc-ip>:8080
APP_PORT=8080
# Where the app is reached from. Use the machine's LAN address, not localhost,
# or browsers on other PCs will be refused.
CORS_ORIGINS=http://localhost:8080
# Set to true ONLY if the app is served over HTTPS. Over plain http the login
# cookie is silently dropped and nobody can sign in.
COOKIE_SECURE=false

# ---- Devices --------------------------------------------------------------
# How often the attendance terminals are polled, in seconds.
SYNC_INTERVAL_SECONDS=300
# Nightly recalculation time, on this machine's clock.
NIGHTLY_HOUR=2
NIGHTLY_MINUTE=0
# Timezone the terminals' own clocks are set to.
DEVICE_TIMEZONE=Europe/Tirane

# ---- Backups --------------------------------------------------------------
BACKUP_HOUR=2
BACKUP_MINUTE=30
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEZONE=Europe/Tirane
